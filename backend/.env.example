# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Secret for Token Signing
JWT_SECRET=teen_spend_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Supabase Credentials (from your Supabase Project Settings -> API)
# URL: Project URL (e.g. https://your-project-ref.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# SERVICE ROLE KEY (Keep this secret! Never expose to frontend!)
# Needed on backend to bypass RLS policies and perform administrative operations.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
